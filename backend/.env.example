PROVIDER=groq
API_KEY=
BASE_URL=
MODEL=qwen/qwen3.8-27b
# Pace requests client-side to stay under the provider's rate limit (0 = off).
REQUESTS_PER_MINUTE=20
# Attach images to the vision agent. Set false for text-only models (e.g. openai/gpt-oss-20b).
VISION_IMAGES=true
# Embed images with OpenCLIP for image search. False skips PyTorch entirely (low-memory hosts);
# images are then searched by their OCR text and caption.
CLIP_IMAGES=true
